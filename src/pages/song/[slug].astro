---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InteractiveControls from '../../components/InteractiveControls';
import { parseAndTranspose, extractLyricsText } from '../../lib/chordEngine';
import { slugify } from '../../lib/slugify';
import { getAllSongs } from '../../lib/songStore';

interface SongFile {
  slug: string;
  rawBody: string;
  data: {
    title: string;
    artist: string;
    movie?: string;
    movieSlug?: string;
    key?: string;
    tempo?: number;
    tags?: string[];
    draft?: boolean;
  };
}

export const prerender = true;

export const getStaticPaths = async () => {
  const songs = getAllSongs();
  return songs.map((s) => ({
    params: { slug: s.slug },
    props: {
      song: {
        slug: s.slug,
        rawBody: s.rawBody,
        data: {
          title: s.title,
          artist: s.artist,
          movie: s.movie,
          movieSlug: s.movieSlug,
          key: s.key,
          tempo: s.tempo,
          tags: s.tags,
          draft: s.draft,
        },
      },
    },
  }));
};

function normalize(s: string): string {
  return s.toLowerCase().trim();
}

interface IndexedSong {
  slug: string;
  title: string;
  artist: string;
  movie?: string;
  tags: string[];
}

function scoreRelated(curr: SongFile, cand: IndexedSong): number {
  if (cand.slug === curr.slug) return -1;
  let score = 0;

  if (curr.data.movie && cand.movie && normalize(curr.data.movie) === normalize(cand.movie)) {
    score += 20;
  }

  const curArtist = normalize(curr.data.artist);
  const candArtist = normalize(cand.artist);
  if (curArtist && candArtist && curArtist === candArtist) score += 10;
  else if (curArtist && candArtist && (curArtist.includes(candArtist) || candArtist.includes(curArtist))) score += 4;

  const currTags = (curr.data.tags ?? []).map(normalize).filter(Boolean);
  const candTags = (cand.tags ?? []).map(normalize).filter(Boolean);
  for (const t of currTags) {
    if (candTags.includes(t)) score += 3;
    else if (candTags.some((x) => x.includes(t) || t.includes(x))) score += 1;
  }

  const currTitleTok = normalize(curr.data.title).split(/\s+/).filter((w) => w.length >= 3);
  const candTitleTok = normalize(cand.title).split(/\s+/).filter((w) => w.length >= 3);
  for (const w of currTitleTok) {
    if (candTitleTok.includes(w)) score += 0.5;
  }
  return score;
}

type Props = { song: SongFile };
const { song } = Astro.props;
if (!song) {
  return Astro.redirect('/404');
}
const rawBody = song.rawBody;

const initial = parseAndTranspose(rawBody, 0);
const title = initial.metadata.title;
const artist = initial.metadata.artist;
const movie = song.data.movie;
const movieSlug = song.data.movieSlug;
const originalKey = initial.metadata.key ?? initial.key;
const tempo = initial.metadata.tempo;
const timeSig = initial.metadata.time;
const lyricsText = extractLyricsText(rawBody);
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);

const artistSlug = slugify(artist);
const pageTitle = `${title} Chords & Lyrics (${originalKey ? `Key of ${originalKey}` : 'Original'}) — ${artist}${movie ? ` (${movie})` : ''} | Guitar & Piano Chords`;
const description = `Play ${title} chords by ${artist}${movie ? ` from ${movie}` : ''} on Guitar, Ukulele & Piano. Features key transpose, capo calculator, auto-scroll, and interactive chord fingering diagrams on WokChords.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'MusicComposition',
    name: title,
    author: {
      '@type': 'Person',
      name: artist,
    },
    byArtist: {
      '@type': 'MusicGroup',
      name: artist,
    },
    inLanguage: 'en',
    url: pageUrl.toString(),
    ...(originalKey ? { musicalKey: originalKey } : {}),
    ...(tempo ? { tempo } : {}),
    ...(timeSig ? { timeSignature: timeSig } : {}),
    lyrics: {
      '@type': 'CreativeWork',
      text: lyricsText.slice(0, 4000),
    },
    publisher: {
      '@type': 'Organization',
      name: 'WokChords',
    },
    isAccessibleForFree: true,
    keywords: ['chords', 'guitar chords', 'piano chords', 'ukulele chords', 'lyrics', artist, title, movie].filter(Boolean).join(', '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: Astro.site?.toString() ?? 'https://wokchords.wokdens.com',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: artist,
        item: `${Astro.site?.toString() ?? 'https://wokchords.wokdens.com'}/artist/${artistSlug}/`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: title,
        item: pageUrl.toString(),
      },
    ],
  },
];

const allSongs = getAllSongs().map((s) => ({
  slug: s.slug,
  title: s.title,
  artist: s.artist,
  movie: s.movie,
  tags: s.tags,
}));

const related = allSongs
  .map((s) => ({ s, score: scoreRelated(song, s) }))
  .filter((x) => x.score >= 0)
  .sort((a, b) => b.score - a.score || a.s.title.localeCompare(b.s.title))
  .slice(0, 6)
  .map((x) => x.s);

const fallback = allSongs
  .filter((s) => s.slug !== song.slug)
  .sort(() => Math.random() - 0.5)
  .slice(0, Math.max(0, 6 - related.length));
const relatedSongs = [...related, ...fallback].slice(0, 6);
---

<BaseLayout title={pageTitle} description={description}>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />

  <div class="max-w-[90rem] mx-auto px-3 sm:px-6 py-4 md:py-6">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-wok-muted mb-4 uppercase tracking-wider font-semibold">
      <a href="/" class="hover:text-wok-accent transition-colors">Home</a>
      <span>/</span>
      <a href={`/artist/${artistSlug}/`} class="hover:text-wok-accent transition-colors truncate">{artist}</a>
      {movie && movieSlug && (
        <>
          <span>/</span>
          <a href={`/movie/${movieSlug}/`} class="hover:text-wok-accent transition-colors truncate">{movie}</a>
        </>
      )}
      <span>/</span>
      <span class="text-wok-accent truncate">{title}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8">
      <!-- Main Sheet Article -->
      <article class="lg:col-span-8 xl:col-span-9 min-w-0">
        <header class="mb-4 md:mb-6">
          <h1 class="text-2xl sm:text-4xl md:text-5xl font-black tracking-tight leading-tight mb-2 text-wok-text">
            {title}
          </h1>
          <p class="text-base sm:text-lg text-wok-muted mb-3 font-medium flex flex-wrap items-center gap-x-2">
            <span>By <a href={`/artist/${artistSlug}/`} class="text-wok-accent hover:underline font-semibold">{artist}</a></span>
            {movie && movieSlug && (
              <span class="text-xs sm:text-sm font-normal text-wok-muted">
                · From <a href={`/movie/${movieSlug}/`} class="text-wok-accent hover:underline font-semibold">🎬 {movie}</a>
              </span>
            )}
          </p>
          <div class="flex flex-wrap gap-2 items-center">
            {originalKey && (
              <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-wok-chord/10 text-wok-chord border border-wok-chord/30 text-xs font-mono font-bold">
                Key {originalKey}
              </span>
            )}
            {tempo && (
              <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 text-wok-muted text-xs font-medium">
                {tempo} BPM
              </span>
            )}
            {timeSig && (
              <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 text-wok-muted text-xs font-medium">
                {timeSig}
              </span>
            )}
            {movie && movieSlug && (
              <a
                href={`/movie/${movieSlug}/`}
                class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-orange-500/10 text-orange-600 dark:text-orange-400 border border-orange-500/20 text-xs font-semibold hover:bg-orange-500/20 transition-colors"
              >
                🎬 {movie} Soundtrack
              </a>
            )}
            {song.data.tags?.map((t) => (
              <a
                href={`/tag/${slugify(t)}/`}
                class="inline-flex items-center px-2.5 py-1 rounded-lg bg-black/5 dark:bg-white/5 text-wok-muted hover:text-wok-text text-xs transition-colors capitalize"
              >
                #{t}
              </a>
            ))}
          </div>
        </header>

        <!-- Interactive Sticky Controls -->
        <InteractiveControls
          client:load
          rawText={rawBody}
          initialKey={originalKey}
          mountId="chord-sheet-mount"
          scrollTargetSelector="#chord-sheet"
        />

        <!-- Original Clean Chord Sheet Display -->
        <div
          id="chord-sheet"
          class="mt-4 md:mt-6 px-5 md:px-8 py-6 md:py-8 rounded-3xl bg-white/85 dark:bg-slate-900/85 backdrop-blur-xl border border-black/5 dark:border-white/10 shadow-xl shadow-orange-950/5 ring-1 ring-black/5 dark:ring-white/5 overflow-x-auto"
        >
          <div id="chord-sheet-mount" class="chordsheetjs select-text" set:html={initial.html}></div>
        </div>

        <noscript>
          <style is:global>
            #chord-sheet-mount .chord { color: #22d3ee; font-weight: 700; font-family: ui-monospace, monospace; }
            #chord-sheet-mount .lyrics, #chord-sheet-mount .lyric { color: #e5e7eb; }
          </style>
        </noscript>
      </article>

      <!-- Sidebar -->
      <aside class="lg:col-span-4 xl:col-span-3 space-y-6">
        <!-- Song Details Card -->
        <div class="rounded-2xl border border-black/5 dark:border-white/10 bg-white/70 dark:bg-slate-900/60 backdrop-blur-md p-5 shadow-sm">
          <h2 class="text-xs font-bold uppercase tracking-wider text-wok-muted mb-4">Song Details</h2>
          <dl class="space-y-2.5 text-xs">
            <div class="flex justify-between py-1 border-b border-black/5 dark:border-white/5">
              <dt class="text-wok-muted">Artist</dt>
              <dd class="font-semibold text-wok-text truncate max-w-[60%]">
                <a href={`/artist/${artistSlug}/`} class="text-wok-accent hover:underline">{artist}</a>
              </dd>
            </div>
            {movie && movieSlug && (
              <div class="flex justify-between py-1 border-b border-black/5 dark:border-white/5">
                <dt class="text-wok-muted">Movie / Album</dt>
                <dd class="font-semibold text-wok-text truncate max-w-[60%]">
                  <a href={`/movie/${movieSlug}/`} class="text-wok-accent hover:underline">{movie}</a>
                </dd>
              </div>
            )}
            {originalKey && (
              <div class="flex justify-between py-1 border-b border-black/5 dark:border-white/5">
                <dt class="text-wok-muted">Original Key</dt>
                <dd class="font-mono font-bold text-wok-chord">{originalKey}</dd>
              </div>
            )}
            {tempo && (
              <div class="flex justify-between py-1 border-b border-black/5 dark:border-white/5">
                <dt class="text-wok-muted">Tempo</dt>
                <dd class="font-mono font-semibold text-wok-text">{tempo} BPM</dd>
              </div>
            )}
            <div class="flex justify-between py-1">
              <dt class="text-wok-muted">Tuning</dt>
              <dd class="font-mono text-wok-muted">Standard (E A D G B E)</dd>
            </div>
          </dl>
        </div>

        <!-- Related Songs Card -->
        {relatedSongs.length > 0 && (
          <div class="rounded-2xl border border-black/5 dark:border-white/10 bg-white/70 dark:bg-slate-900/60 backdrop-blur-md p-5 shadow-sm">
            <h2 class="text-xs font-bold uppercase tracking-wider text-wok-muted mb-4">
              {movie ? `More from ${movie}` : `More by ${artist}`}
            </h2>
            <ul class="space-y-2">
              {relatedSongs.map((rel) => (
                <li>
                  <a
                    href={`/song/${rel.slug}/`}
                    class="group flex items-start gap-2.5 p-2 rounded-xl hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
                  >
                    <div class="mt-0.5 w-7 h-7 shrink-0 rounded-lg bg-wok-accent/15 text-wok-accent font-bold text-xs flex items-center justify-center group-hover:bg-wok-accent group-hover:text-white transition-colors">
                      {rel.title.charAt(0)}
                    </div>
                    <div class="min-w-0 flex-1">
                      <p class="text-xs font-semibold text-wok-text group-hover:text-wok-accent transition-colors truncate">
                        {rel.title}
                      </p>
                      <p class="text-[11px] text-wok-muted truncate">
                        {rel.artist}{rel.movie ? ` · ${rel.movie}` : ''}
                      </p>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </div>

  <!-- Original WokChords Typography & Sheet Styling -->
  <style is:global>
    #chord-sheet-mount .chord {
      color: rgb(var(--wok-chord));
      font-weight: 700;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.95rem;
      line-height: 1.25;
      cursor: pointer;
      user-select: none;
      display: inline-block;
      transition: color 0.15s ease, transform 0.15s ease;
    }
    #chord-sheet-mount .chord:hover {
      color: rgb(var(--wok-accent));
      transform: translateY(-1px);
      text-decoration: underline;
    }
    @media (min-width: 768px) {
      #chord-sheet-mount .chord {
        font-size: 1.05rem;
      }
    }
    #chord-sheet-mount .lyrics, #chord-sheet-mount .lyric {
      color: rgb(var(--wok-text));
      font-size: 1rem;
      line-height: 1.6;
      white-space: pre-wrap;
      font-family: inherit;
    }
    @media (min-width: 768px) {
      #chord-sheet-mount .lyrics, #chord-sheet-mount .lyric {
        font-size: 1.125rem;
      }
    }
    #chord-sheet-mount .comment, #chord-sheet-mount .label {
      text-transform: uppercase;
      font-size: 0.75rem;
      letter-spacing: 0.12em;
      font-weight: 700;
      color: rgb(var(--wok-muted));
      margin: 1.5rem 0 0.5rem;
      padding-left: 0.75rem;
      border-left: 3px solid rgb(var(--wok-accent));
    }
    @media (min-width: 768px) {
      #chord-sheet-mount .comment, #chord-sheet-mount .label {
        font-size: 0.8rem;
      }
    }
    #chord-sheet-mount .row {
      margin-bottom: 0.4rem;
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      row-gap: 0.5rem;
    }
    #chord-sheet-mount .column {
      display: inline-flex;
      flex-direction: column;
      vertical-align: bottom;
      min-width: fit-content;
    }
    #chord-sheet-mount .verse,
    #chord-sheet-mount .chorus,
    #chord-sheet-mount .bridge,
    #chord-sheet-mount .tab,
    #chord-sheet-mount .indeterminate {
      margin-bottom: 1.25rem;
    }
    @media (min-width: 768px) {
      #chord-sheet-mount .verse,
      #chord-sheet-mount .chorus,
      #chord-sheet-mount .bridge,
      #chord-sheet-mount .tab,
      #chord-sheet-mount .indeterminate {
        margin-bottom: 1.5rem;
      }
    }
  </style>
</BaseLayout>
