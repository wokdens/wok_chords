---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InteractiveControls from '../../components/InteractiveControls';
import ShareButton from '../../components/ShareButton';
import { parseAndTranspose, extractLyricsText } from '../../lib/chordEngine';
import { slugify } from '../../lib/slugify';
import { getAllSongs } from '../../lib/songStore';
import { findOptimalEasyChords } from '../../lib/simplifyChordEngine';

interface SongFile {
  slug: string;
  rawBody: string;
  data: {
    title: string;
    artist: string;
    movie?: string;
    movieSlug?: string;
    key?: string;
    tempo?: number;
    tags?: string[];
    draft?: boolean;
  };
}

export const prerender = true;

export const getStaticPaths = async () => {
  const songs = getAllSongs();
  return songs.map((s) => ({
    params: { slug: s.slug },
    props: {
      song: {
        slug: s.slug,
        rawBody: s.rawBody,
        data: {
          title: s.title,
          artist: s.artist,
          movie: s.movie,
          movieSlug: s.movieSlug,
          key: s.key,
          tempo: s.tempo,
          tags: s.tags,
          draft: s.draft,
        },
      },
    },
  }));
};

function normalize(s: string): string {
  return s.toLowerCase().trim();
}

type Props = { song: SongFile };
const { song } = Astro.props;
if (!song) {
  return Astro.redirect('/404');
}
const rawBody = song.rawBody;

const initial = parseAndTranspose(rawBody, 0);
const title = song.data.title || initial.metadata.title || 'Untitled';
const artist = song.data.artist || initial.metadata.artist || 'Unknown Artist';
const movie = song.data.movie;
const movieSlug = song.data.movieSlug || (movie ? slugify(movie) : undefined);
const originalKey = song.data.key || initial.metadata.key || initial.key;
const tempo = song.data.tempo || initial.metadata.tempo;
const timeSig = initial.metadata.time;
const lyricsText = extractLyricsText(rawBody);

const baseUrl = 'https://wokchords.wokdens.com';
const pageCanonical = `${baseUrl}/song/${song.slug}/`;

const artistSlug = slugify(artist);

// 1. Language determination from genuine tags
const LANGUAGE_CONFIG: Record<string, { name: string; code: string; slug: string }> = {
  hindi: { name: 'Hindi', code: 'hi', slug: 'hindi' },
  bollywood: { name: 'Hindi', code: 'hi', slug: 'hindi' },
  punjabi: { name: 'Punjabi', code: 'pa', slug: 'punjabi' },
  bengali: { name: 'Bengali', code: 'bn', slug: 'bengali' },
  tamil: { name: 'Tamil', code: 'ta', slug: 'tamil' },
  telugu: { name: 'Telugu', code: 'te', slug: 'telugu' },
  marathi: { name: 'Marathi', code: 'mr', slug: 'marathi' },
  spanish: { name: 'Spanish', code: 'es', slug: 'spanish' },
  english: { name: 'English', code: 'en', slug: 'english' },
};

const LANGUAGE_PRIORITY = ['spanish', 'bengali', 'punjabi', 'marathi', 'tamil', 'telugu', 'hindi', 'bollywood', 'english'];
let primaryLang = { name: 'English', code: 'en', slug: 'english' };
if (song.data.tags && song.data.tags.length > 0) {
  const normTags = song.data.tags.map((t) => t.toLowerCase().trim());
  for (const langKey of LANGUAGE_PRIORITY) {
    if (normTags.includes(langKey) && LANGUAGE_CONFIG[langKey]) {
      primaryLang = LANGUAGE_CONFIG[langKey];
      break;
    }
  }
}

// 2. Chords analysis
const uniqueChords = initial.uniqueChords || [];
const totalChordsCount = uniqueChords.length;
const chordSummaryStr = uniqueChords.slice(0, 5).join(', ');

const EASY_CHORDS_SET = new Set([
  'C', 'C7', 'Cmaj7', 'Cadd9',
  'D', 'D7', 'Dm', 'Dsus2', 'Dsus4',
  'E', 'E7', 'Em', 'Em7', 'Esus4',
  'G', 'G7', 'Gadd9',
  'A', 'A7', 'Am', 'Am7', 'Asus2', 'Asus4',
  'F', 'Fmaj7',
]);
const isBeginnerFriendly = uniqueChords.length > 0 && uniqueChords.every((c) => EASY_CHORDS_SET.has(c.split('/')[0]));
const capoRecommendation = findOptimalEasyChords(uniqueChords);

// 3. Dynamic Scalable Title
const cleanMovie = movie ? ` (${movie})` : '';
const cleanKey = originalKey ? ` [Key ${originalKey}]` : '';
const pageTitle = `${title} Guitar Chords & Lyrics — ${artist}${cleanMovie}${cleanKey} | WokChords`;

// 4. Dynamic Scalable Meta Description
const descParts: string[] = [];
if (movie) {
  descParts.push(`Accurate guitar chords and lyrics for "${title}" by ${artist} from ${movie}.`);
} else {
  descParts.push(`Accurate guitar chords and lyrics for "${title}" by ${artist}.`);
}

if (originalKey && uniqueChords.length > 0) {
  descParts.push(`Original key ${originalKey}. Chords used: ${chordSummaryStr}.`);
} else if (originalKey) {
  descParts.push(`In original key ${originalKey}.`);
} else if (uniqueChords.length > 0) {
  descParts.push(`Chords used: ${chordSummaryStr}.`);
}

if (capoRecommendation && capoRecommendation.capoFret > 0) {
  descParts.push(`Capo on fret ${capoRecommendation.capoFret} recommended for simpler chord shapes.`);
} else if (isBeginnerFriendly) {
  descParts.push(`Features standard beginner-friendly open chords.`);
}

descParts.push(`Free interactive pitch transpose, capo chart, tuner, and auto-scroll on WokChords.`);
const pageDescription = descParts.join(' ');

// 5. Breadcrumb Elements & JSON-LD
const breadcrumbElements: Array<{ '@type': string; position: number; name: string; item: string }> = [
  {
    '@type': 'ListItem',
    position: 1,
    name: 'Home',
    item: `${baseUrl}/`,
  },
  {
    '@type': 'ListItem',
    position: 2,
    name: `${primaryLang.name} Songs`,
    item: `${baseUrl}/tag/${primaryLang.slug}/`,
  },
  {
    '@type': 'ListItem',
    position: 3,
    name: artist,
    item: `${baseUrl}/artist/${artistSlug}/`,
  },
];

if (movie && movieSlug) {
  breadcrumbElements.push({
    '@type': 'ListItem',
    position: breadcrumbElements.length + 1,
    name: movie,
    item: `${baseUrl}/movie/${movieSlug}/`,
  });
}

breadcrumbElements.push({
  '@type': 'ListItem',
  position: breadcrumbElements.length + 1,
  name: title,
  item: pageCanonical,
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'MusicComposition',
      name: `${title} (Guitar Chords & Lyrics)`,
      alternateName: title,
      composer: {
        '@type': 'Person',
        name: artist,
      },
      byArtist: {
        '@type': 'MusicGroup',
        name: artist,
        url: `${baseUrl}/artist/${artistSlug}/`,
      },
      inLanguage: primaryLang.code,
      url: pageCanonical,
      ...(originalKey ? { musicalKey: originalKey } : {}),
      ...(tempo ? { tempo } : {}),
      ...(timeSig ? { timeSignature: timeSig } : {}),
      lyrics: {
        '@type': 'CreativeWork',
        text: lyricsText.slice(0, 3000),
      },
      publisher: {
        '@type': 'Organization',
        name: 'WokChords',
        url: `${baseUrl}/`,
      },
      ...(movie && movieSlug
        ? {
            isPartOf: {
              '@type': 'MusicAlbum',
              name: movie,
              url: `${baseUrl}/movie/${movieSlug}/`,
            },
          }
        : {}),
      isAccessibleForFree: true,
      keywords: ['guitar chords', 'lyrics', 'chords', artist, title, movie, primaryLang.name].filter(Boolean).join(', '),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbElements,
    },
  ],
};

// 6. Multi-faceted Internal Link Datasets
const allSongs = getAllSongs();
const curArtistNorm = normalize(artist);
const curMovieNorm = movie ? normalize(movie) : '';
const curLangTag = primaryLang.slug;

const allArtistSongs = allSongs.filter((s) => s.artist && normalize(s.artist) === curArtistNorm);
const moreByArtist = allArtistSongs.filter((s) => s.slug !== song.slug).slice(0, 6);

const allMovieSongs = curMovieNorm
  ? allSongs.filter((s) => s.movie && normalize(s.movie) === curMovieNorm)
  : [];
const moreInMovie = allMovieSongs.filter((s) => s.slug !== song.slug).slice(0, 6);

const moreInLang = allSongs
  .filter((s) => s.slug !== song.slug && s.tags?.some((t) => t.toLowerCase() === curLangTag))
  .slice(0, 6);

const firstChar = title.trim().charAt(0).toUpperCase();
const letterChar = /^[A-Z]$/.test(firstChar) ? firstChar : '#';
const letterSlug = letterChar === '#' ? 'num' : letterChar.toLowerCase();

const OG_LOCALE_MAP: Record<string, string> = {
  en: 'en_US',
  es: 'es_ES',
  hi: 'hi_IN',
  pa: 'pa_IN',
  bn: 'bn_IN',
  mr: 'mr_IN',
  ta: 'ta_IN',
  te: 'te_IN',
};
const ogLocale = OG_LOCALE_MAP[primaryLang.code] || 'en_US';
---

<BaseLayout title={pageTitle} description={pageDescription} ogType="music.song" lang={primaryLang.code} ogLocale={ogLocale}>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />

  <div class="max-w-[90rem] w-full mx-auto px-3 sm:px-6 py-4 md:py-6 min-w-0">
    <!-- Breadcrumb Hierarchy -->
    <nav class="flex items-center gap-1.5 sm:gap-2 text-xs text-wok-muted mb-4 uppercase tracking-wider font-semibold flex-wrap" aria-label="Breadcrumb">
      <a href="/" class="hover:text-wok-accent transition-colors">Home</a>
      <span>/</span>
      <a href={`/tag/${primaryLang.slug}/`} class="hover:text-wok-accent transition-colors capitalize">{primaryLang.name} Songs</a>
      <span>/</span>
      <a href={`/artist/${artistSlug}/`} class="hover:text-wok-accent transition-colors truncate">{artist}</a>
      {movie && movieSlug && (
        <>
          <span>/</span>
          <a href={`/movie/${movieSlug}/`} class="hover:text-wok-accent transition-colors truncate">🎬 {movie}</a>
        </>
      )}
      <span>/</span>
      <span class="text-wok-accent truncate">{title}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 min-w-0 w-full">
      <!-- Main Sheet Article -->
      <article class="lg:col-span-8 xl:col-span-9 min-w-0 w-full">
        <header class="mb-4 md:mb-6">
          <h1 class="text-2xl sm:text-4xl md:text-5xl font-black tracking-tight leading-tight mb-2 text-wok-text">
            {title} <span class="text-wok-accent text-lg sm:text-2xl md:text-3xl font-extrabold block sm:inline">Guitar Chords & Lyrics</span>
          </h1>
          <p class="text-base sm:text-lg text-wok-muted mb-3 font-medium flex flex-wrap items-center gap-x-2">
            <span>By <a href={`/artist/${artistSlug}/`} class="text-wok-accent hover:underline font-semibold">{artist}</a></span>
            {movie && movieSlug && (
              <span class="text-xs sm:text-sm font-normal text-wok-muted">
                · From <a href={`/movie/${movieSlug}/`} class="text-wok-accent hover:underline font-semibold">🎬 {movie}</a>
              </span>
            )}
          </p>

          <div class="flex flex-wrap gap-2 items-center">
            {originalKey && (
              <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-wok-chord/10 text-wok-chord border border-wok-chord/30 text-xs font-mono font-bold">
                Key {originalKey}
              </span>
            )}
            {tempo && (
              <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 text-wok-muted text-xs font-medium">
                {tempo} BPM
              </span>
            )}
            {timeSig && (
              <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 text-wok-muted text-xs font-medium">
                {timeSig}
              </span>
            )}
            {movie && movieSlug && (
              <a
                href={`/movie/${movieSlug}/`}
                class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-orange-500/10 text-orange-600 dark:text-orange-400 border border-orange-500/20 text-xs font-semibold hover:bg-orange-500/20 transition-colors"
              >
                🎬 {movie} Soundtrack
              </a>
            )}
            {song.data.tags?.map((t) => (
              <a
                href={`/tag/${slugify(t)}/`}
                class="inline-flex items-center px-2.5 py-1 rounded-lg bg-black/5 dark:bg-white/5 text-wok-muted hover:text-wok-text text-xs transition-colors capitalize"
              >
                #{t}
              </a>
            ))}
            <a
              href="/tuner/"
              class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-orange-500/10 text-orange-600 dark:text-orange-400 hover:bg-orange-500 hover:text-white text-xs font-semibold transition-colors"
              title="Tune guitar before playing"
            >
              🎸 Tuner
            </a>
            <ShareButton client:load title={title} artist={artist} url={pageCanonical} />
          </div>

          <!-- Visual Chord Badges in Song -->
          {uniqueChords.length > 0 && (
            <div class="mt-4 pt-3 border-t border-black/5 dark:border-white/5">
              <h2 class="text-xs font-bold uppercase tracking-wider text-wok-muted mb-2 flex items-center gap-1.5">
                <span>Chords in this Song ({totalChordsCount})</span>
              </h2>
              <div class="flex flex-wrap gap-1.5">
                {uniqueChords.map((chord) => (
                  <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-wok-chord/10 text-wok-chord border border-wok-chord/20 text-xs font-mono font-bold">
                    {chord}
                  </span>
                ))}
              </div>
            </div>
          )}

          <!-- Capo Recommendation (Only if genuine) -->
          {capoRecommendation && capoRecommendation.capoFret > 0 && (
            <div class="mt-3 p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 text-xs text-amber-800 dark:text-amber-300 flex items-center gap-2">
              <span class="text-base shrink-0">💡</span>
              <span>
                <strong>Capo Recommendation:</strong> Place Capo on <strong>Fret {capoRecommendation.capoFret}</strong> to play with simpler open chord shapes ({capoRecommendation.sampleChords.join(', ')}).
              </span>
            </div>
          )}
        </header>

        <!-- Interactive Sticky Controls -->
        <InteractiveControls
          client:load
          rawText={rawBody}
          initialKey={originalKey}
          mountId="chord-sheet-mount"
          scrollTargetSelector="#chord-sheet"
        />

        <!-- Pre-rendered Static Chord Sheet (100% Crawlable Server Output) -->
        <div
          id="chord-sheet"
          class="mt-4 md:mt-6 px-5 md:px-8 py-6 md:py-8 rounded-3xl bg-white/85 dark:bg-slate-900/85 backdrop-blur-xl border border-black/5 dark:border-white/10 shadow-xl shadow-orange-950/5 ring-1 ring-black/5 dark:ring-white/5 overflow-x-auto"
        >
          <div id="chord-sheet-mount" class="chordsheetjs select-text" set:html={initial.html}></div>
        </div>

        <noscript>
          <style is:global>
            #chord-sheet-mount .chord { color: #22d3ee; font-weight: 700; font-family: ui-monospace, monospace; }
            #chord-sheet-mount .lyrics, #chord-sheet-mount .lyric { color: #e5e7eb; }
          </style>
        </noscript>

        <!-- Print-Only Footer Attribution -->
        <div class="print-only-footer">
          <span>Printed from <strong>WokChords</strong> — wokchords.wokdens.com</span>
          <span>100% Free &amp; Ad-Free Guitar Chords</span>
        </div>

        <!-- Internal Link Section 1: More by Artist -->
        {moreByArtist.length > 0 && (
          <section class="mt-8 pt-8 border-t border-black/10 dark:border-white/10">
            <div class="flex items-center justify-between gap-3 mb-4">
              <h2 class="text-lg sm:text-xl font-black text-wok-text tracking-tight">
                More Songs by {artist}
              </h2>
              <a
                href={`/artist/${artistSlug}/`}
                class="text-xs font-bold text-wok-accent hover:underline flex items-center gap-1 shrink-0"
              >
                <span>View all {allArtistSongs.length} songs</span>
                <span>→</span>
              </a>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
              {moreByArtist.map((s) => (
                <a
                  href={`/song/${s.slug}/`}
                  class="group flex flex-col justify-between p-3.5 rounded-xl border border-black/5 dark:border-white/5 bg-wok-panel/30 hover:bg-wok-panel/80 hover:border-wok-accent/40 hover:-translate-y-0.5 transition-all shadow-sm duration-150"
                >
                  <div>
                    <div class="flex items-start justify-between gap-2 mb-1">
                      <h3 class="font-bold text-xs sm:text-sm text-wok-text group-hover:text-wok-accent transition-colors truncate">
                        {s.title}
                      </h3>
                      {s.key && (
                        <span class="shrink-0 px-1.5 py-0.5 rounded bg-wok-chord/10 text-wok-chord text-[10px] font-mono font-bold">
                          {s.key}
                        </span>
                      )}
                    </div>
                    {s.movie && (
                      <p class="text-[11px] text-wok-muted truncate">🎬 {s.movie}</p>
                    )}
                  </div>
                  <span class="text-[11px] font-semibold text-wok-accent group-hover:underline mt-2 flex items-center gap-1">
                    <span>Play Chords</span>
                    <span>→</span>
                  </span>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- Internal Link Section 2: More from Movie Soundtrack -->
        {moreInMovie.length > 0 && (
          <section class="mt-8 pt-8 border-t border-black/10 dark:border-white/10">
            <div class="flex items-center justify-between gap-3 mb-4">
              <h2 class="text-lg sm:text-xl font-black text-wok-text tracking-tight">
                More Songs from {movie} Soundtrack
              </h2>
              <a
                href={`/movie/${movieSlug}/`}
                class="text-xs font-bold text-wok-accent hover:underline flex items-center gap-1 shrink-0"
              >
                <span>View full album ({allMovieSongs.length} tracks)</span>
                <span>→</span>
              </a>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
              {moreInMovie.map((s) => (
                <a
                  href={`/song/${s.slug}/`}
                  class="group flex flex-col justify-between p-3.5 rounded-xl border border-black/5 dark:border-white/5 bg-wok-panel/30 hover:bg-wok-panel/80 hover:border-wok-accent/40 hover:-translate-y-0.5 transition-all shadow-sm duration-150"
                >
                  <div>
                    <div class="flex items-start justify-between gap-2 mb-1">
                      <h3 class="font-bold text-xs sm:text-sm text-wok-text group-hover:text-wok-accent transition-colors truncate">
                        {s.title}
                      </h3>
                      {s.key && (
                        <span class="shrink-0 px-1.5 py-0.5 rounded bg-wok-chord/10 text-wok-chord text-[10px] font-mono font-bold">
                          {s.key}
                        </span>
                      )}
                    </div>
                    <p class="text-[11px] text-wok-muted truncate">{s.artist}</p>
                  </div>
                  <span class="text-[11px] font-semibold text-wok-accent group-hover:underline mt-2 flex items-center gap-1">
                    <span>Play Chords</span>
                    <span>→</span>
                  </span>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- Internal Link Section 3: Popular in Language -->
        {moreInLang.length > 0 && (
          <section class="mt-8 pt-8 border-t border-black/10 dark:border-white/10">
            <div class="flex items-center justify-between gap-3 mb-4">
              <h2 class="text-lg sm:text-xl font-black text-wok-text tracking-tight">
                Popular {primaryLang.name} Guitar Chords
              </h2>
              <a
                href={`/tag/${primaryLang.slug}/`}
                class="text-xs font-bold text-wok-accent hover:underline flex items-center gap-1 shrink-0"
              >
                <span>Browse all {primaryLang.name} songs</span>
                <span>→</span>
              </a>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
              {moreInLang.map((s) => (
                <a
                  href={`/song/${s.slug}/`}
                  class="group flex flex-col justify-between p-3.5 rounded-xl border border-black/5 dark:border-white/5 bg-wok-panel/30 hover:bg-wok-panel/80 hover:border-wok-accent/40 hover:-translate-y-0.5 transition-all shadow-sm duration-150"
                >
                  <div>
                    <div class="flex items-start justify-between gap-2 mb-1">
                      <h3 class="font-bold text-xs sm:text-sm text-wok-text group-hover:text-wok-accent transition-colors truncate">
                        {s.title}
                      </h3>
                      {s.key && (
                        <span class="shrink-0 px-1.5 py-0.5 rounded bg-wok-chord/10 text-wok-chord border border-wok-chord/20 text-[10px] font-mono font-bold">
                          {s.key}
                        </span>
                      )}
                    </div>
                    <p class="text-[11px] text-wok-muted truncate">{s.artist}{s.movie ? ` · ${s.movie}` : ''}</p>
                  </div>
                  <span class="text-[11px] font-semibold text-wok-accent group-hover:underline mt-2 flex items-center gap-1">
                    <span>Play Chords</span>
                    <span>→</span>
                  </span>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- Internal Link Section 4: Exploration Hub -->
        <section class="mt-8 pt-8 border-t border-black/10 dark:border-white/10">
          <div class="p-5 rounded-2xl border border-black/5 dark:border-white/5 bg-wok-panel/20">
            <h2 class="text-xs font-bold uppercase tracking-wider text-wok-muted mb-3">
              Explore WokChords Music Directory
            </h2>
            <div class="flex flex-wrap gap-2 text-xs font-semibold">
              <a
                href={`/songs/${letterSlug}/`}
                class="px-3 py-1.5 rounded-xl bg-black/5 dark:bg-white/5 text-wok-text hover:bg-wok-accent hover:text-white transition-colors"
              >
                Songs Starting With "{letterChar}" →
              </a>
              <a
                href="/tuner/"
                class="px-3 py-1.5 rounded-xl bg-orange-500/10 text-orange-600 dark:text-orange-400 hover:bg-orange-500 hover:text-white transition-colors"
              >
                🎸 Free Guitar Tuner
              </a>
              <a
                href="/artists/"
                class="px-3 py-1.5 rounded-xl bg-black/5 dark:bg-white/5 text-wok-text hover:bg-wok-accent hover:text-white transition-colors"
              >
                Artists Directory (A–Z)
              </a>
              <a
                href="/movies/"
                class="px-3 py-1.5 rounded-xl bg-black/5 dark:bg-white/5 text-wok-text hover:bg-wok-accent hover:text-white transition-colors"
              >
                Movie Soundtracks
              </a>
              <a
                href="/songs/"
                class="px-3 py-1.5 rounded-xl bg-black/5 dark:bg-white/5 text-wok-text hover:bg-wok-accent hover:text-white transition-colors"
              >
                All 4,000+ Songs Hub
              </a>
            </div>
          </div>
        </section>
      </article>

      <!-- Sidebar -->
      <aside class="lg:col-span-4 xl:col-span-3 space-y-6 w-full min-w-0">
        <!-- Song Details Card -->
        <div class="rounded-2xl border border-black/5 dark:border-white/10 bg-white/70 dark:bg-slate-900/60 backdrop-blur-md p-5 shadow-sm">
          <h2 class="text-xs font-bold uppercase tracking-wider text-wok-muted mb-4">Song Information</h2>
          <dl class="space-y-2.5 text-xs">
            <div class="flex justify-between py-1 border-b border-black/5 dark:border-white/5">
              <dt class="text-wok-muted">Artist</dt>
              <dd class="font-semibold text-wok-text truncate max-w-[60%]">
                <a href={`/artist/${artistSlug}/`} class="text-wok-accent hover:underline">{artist}</a>
              </dd>
            </div>
            {movie && movieSlug && (
              <div class="flex justify-between py-1 border-b border-black/5 dark:border-white/5">
                <dt class="text-wok-muted">Movie / Album</dt>
                <dd class="font-semibold text-wok-text truncate max-w-[60%]">
                  <a href={`/movie/${movieSlug}/`} class="text-wok-accent hover:underline">{movie}</a>
                </dd>
              </div>
            )}
            <div class="flex justify-between py-1 border-b border-black/5 dark:border-white/5">
              <dt class="text-wok-muted">Language</dt>
              <dd class="font-semibold text-wok-text">
                <a href={`/tag/${primaryLang.slug}/`} class="text-wok-accent hover:underline capitalize">{primaryLang.name}</a>
              </dd>
            </div>
            {originalKey && (
              <div class="flex justify-between py-1 border-b border-black/5 dark:border-white/5">
                <dt class="text-wok-muted">Original Key</dt>
                <dd class="font-mono font-bold text-wok-chord">{originalKey}</dd>
              </div>
            )}
            {tempo && (
              <div class="flex justify-between py-1 border-b border-black/5 dark:border-white/5">
                <dt class="text-wok-muted">Tempo</dt>
                <dd class="font-mono font-semibold text-wok-text">{tempo} BPM</dd>
              </div>
            )}
            {timeSig && (
              <div class="flex justify-between py-1 border-b border-black/5 dark:border-white/5">
                <dt class="text-wok-muted">Time Signature</dt>
                <dd class="font-mono font-semibold text-wok-text">{timeSig}</dd>
              </div>
            )}
            <div class="flex justify-between py-1 border-b border-black/5 dark:border-white/5">
              <dt class="text-wok-muted">Chords</dt>
              <dd class="font-mono text-wok-text font-semibold">{totalChordsCount} unique</dd>
            </div>
            <div class="flex justify-between py-1 border-b border-black/5 dark:border-white/5">
              <dt class="text-wok-muted">Tuning</dt>
              <dd>
                <a href="/tuner/" class="font-mono text-wok-accent hover:underline">Standard (EADGBE) ↗</a>
              </dd>
            </div>
            <div class="flex justify-between py-1">
              <dt class="text-wok-muted">Difficulty</dt>
              <dd class="font-semibold text-wok-text">
                {isBeginnerFriendly ? '🟢 Beginner (Open Chords)' : (capoRecommendation ? '🟡 Capo Recommended' : '🔵 Intermediate')}
              </dd>
            </div>
          </dl>
        </div>

        <!-- Free Guitar Tuner Widget Banner -->
        <div class="rounded-2xl border border-orange-500/20 bg-gradient-to-br from-orange-500/10 to-amber-500/10 p-4 shadow-sm">
          <div class="flex items-start gap-3">
            <span class="text-2xl">🎸</span>
            <div>
              <h3 class="text-xs font-bold text-wok-text uppercase tracking-wider">Free Guitar Tuner</h3>
              <p class="text-[11px] text-wok-muted mt-0.5 leading-relaxed">
                Tune your guitar or ukulele with mic pitch detection before playing.
              </p>
              <a
                href="/tuner/"
                class="inline-flex items-center gap-1 mt-2.5 px-3 py-1 rounded-lg bg-orange-500 hover:bg-orange-600 text-white font-bold text-xs transition-colors shadow-sm"
              >
                <span>Launch Tuner</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <!-- Original WokChords Typography & Sheet Styling -->
  <style is:global>
    #chord-sheet-mount .chord {
      color: rgb(var(--wok-chord));
      font-weight: 700;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.95rem;
      line-height: 1.25;
      cursor: pointer;
      user-select: none;
      display: inline-block;
      transition: color 0.15s ease, transform 0.15s ease;
    }
    #chord-sheet-mount .chord:hover {
      color: rgb(var(--wok-accent));
      transform: translateY(-1px);
      text-decoration: underline;
    }
    @media (min-width: 768px) {
      #chord-sheet-mount .chord {
        font-size: 1.05rem;
      }
    }
    #chord-sheet-mount .lyrics, #chord-sheet-mount .lyric {
      color: rgb(var(--wok-text));
      font-size: 1rem;
      line-height: 1.6;
      white-space: pre-wrap;
      font-family: inherit;
    }
    @media (min-width: 768px) {
      #chord-sheet-mount .lyrics, #chord-sheet-mount .lyric {
        font-size: 1.125rem;
      }
    }
    #chord-sheet-mount .comment, #chord-sheet-mount .label {
      text-transform: uppercase;
      font-size: 0.75rem;
      letter-spacing: 0.12em;
      font-weight: 700;
      color: rgb(var(--wok-muted));
      margin: 1.5rem 0 0.5rem;
      padding-left: 0.75rem;
      border-left: 3px solid rgb(var(--wok-accent));
    }
    @media (min-width: 768px) {
      #chord-sheet-mount .comment, #chord-sheet-mount .label {
        font-size: 0.8rem;
      }
    }
    #chord-sheet-mount .row {
      margin-bottom: 0.4rem;
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      row-gap: 0.5rem;
    }
    #chord-sheet-mount .column {
      display: inline-flex;
      flex-direction: column;
      vertical-align: bottom;
      min-width: fit-content;
    }
    #chord-sheet-mount .verse,
    #chord-sheet-mount .chorus,
    #chord-sheet-mount .bridge,
    #chord-sheet-mount .tab,
    #chord-sheet-mount .indeterminate {
      margin-bottom: 1.25rem;
    }
    @media (min-width: 768px) {
      #chord-sheet-mount .verse,
      #chord-sheet-mount .chorus,
      #chord-sheet-mount .bridge,
      #chord-sheet-mount .tab,
      #chord-sheet-mount .indeterminate {
        margin-bottom: 1.5rem;
      }
    }
  </style>

  <script is:inline define:vars={{ title, artist, originalKey, tempo }}>
    try {
      if (typeof window !== 'undefined' && typeof window.gtag === 'function') {
        window.gtag('event', 'song_view', {
          song_title: title,
          artist_name: artist,
          musical_key: originalKey || 'unknown',
          tempo: tempo || 0,
        });
      }
    } catch (e) {}
  </script>
</BaseLayout>
