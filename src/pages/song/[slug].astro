---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InteractiveControls from '../../components/InteractiveControls';
import { parseAndTranspose, extractLyricsText } from '../../lib/chordEngine';

interface SongFile {
  slug: string;
  rawBody: string;
  data: {
    title: string;
    artist: string;
    key?: string;
    tempo?: number;
    tags?: string[];
    draft?: boolean;
  };
}

interface IndexedSong {
  slug: string;
  title: string;
  artist: string;
  key?: string;
  tags?: string[];
  snippet?: string;
}

const ALL_SONGS: Promise<IndexedSong[]> = (async () => {
  const mods = import.meta.glob<string>('/src/content/songs/*.chopro', {
    query: '?raw',
    import: 'default',
    eager: true,
  });
  const rows: IndexedSong[] = [];
  for (const [filePath, rawText] of Object.entries(mods)) {
    const fm = rawText.match(/^---\n([\s\S]*?)\n---\n?/)?.[1] ?? '';
    const data: Record<string, any> = {};
    for (const line of fm.split('\n')) {
      const m = line.match(/^(\w+):\s*(.*)$/);
      if (!m) continue;
      const [, k, vRaw] = m;
      let v: any = vRaw.trim().replace(/^["']|["']$/g, '');
      if (v.startsWith('[') && v.endsWith(']')) {
        try { v = JSON.parse(v); } catch {
          v = v.slice(1, -1).split(',').map((s: string) => s.trim().replace(/^["']|["']$/g, ''));
        }
      }
      data[k] = v;
    }
    if (data.draft === true || data.draft === 'true') continue;
    const slug = filePath.match(/\/([^/]+)\.chopro$/)?.[1] ?? filePath;
    const snippetMatch = rawText
      .replace(/^---[\s\S]*?---\n?/, '')
      .replace(/\{[^{}]*\}/g, '')
      .replace(/\[[^\]]*\]/g, '')
      .replace(/\s+/g, ' ')
      .trim()
      .slice(0, 70);
    rows.push({
      slug,
      title: data.title ?? slug.replace(/-/g, ' '),
      artist: data.artist ?? 'Unknown Artist',
      key: data.key,
      tags: data.tags ?? [],
      snippet: snippetMatch,
    });
  }
  return rows;
})();

export const prerender = true;

export const getStaticPaths = async () => {
  const modules = import.meta.glob<string>('/src/content/songs/*.chopro', {
    query: '?raw',
    import: 'default',
    eager: true,
  });
  const list: SongFile[] = Object.entries(modules).map(([filePath, rawText]) => {
    const m = rawText.match(/^---\n([\s\S]*?)\n---\n?/);
    const data: Record<string, any> = {};
    if (m) {
      for (const line of m[1].split('\n')) {
        const lm = line.match(/^(\w+):\s*(.*)$/);
        if (!lm) continue;
        const [, k, vRaw] = lm;
        let v: any = vRaw.trim().replace(/^["']|["']$/g, '');
        if (v.startsWith('[') && v.endsWith(']')) {
          try {
            v = JSON.parse(v);
          } catch {
            v = v.slice(1, -1).split(',').map((s: string) => s.trim().replace(/^["']|["']$/g, ''));
          }
        }
        if (k === 'tempo') {
          const n = Number(v);
          if (!Number.isNaN(n)) v = n;
        }
        if (k === 'draft') {
          v = v === 'true' || v === true;
        }
        data[k] = v;
      }
    }
    const slugMatch = filePath.match(/\/([^/]+)\.chopro$/);
    const slug = slugMatch ? slugMatch[1] : filePath;
    return { slug, rawBody: rawText, data } as SongFile;
  });
  return list
    .filter((s) => !s.data.draft)
    .map((song) => ({
      params: { slug: song.slug },
      props: { song },
    }));
};

function normalize(s: string): string {
  return s.toLowerCase().trim();
}

function scoreRelated(curr: SongFile, cand: IndexedSong): number {
  if (cand.slug === curr.slug) return -1;
  let score = 0;
  const curArtist = normalize(curr.data.artist);
  const candArtist = normalize(cand.artist);
  if (curArtist && candArtist && curArtist === candArtist) score += 10;
  else if (curArtist && candArtist && (curArtist.includes(candArtist) || candArtist.includes(curArtist))) score += 4;

  const currTags = (curr.data.tags ?? []).map(normalize).filter(Boolean);
  const candTags = (cand.tags ?? []).map(normalize).filter(Boolean);
  for (const t of currTags) {
    if (candTags.includes(t)) score += 3;
    else if (candTags.some((x) => x.includes(t) || t.includes(x))) score += 1;
  }

  const currTitleTok = normalize(curr.data.title).split(/\s+/).filter((w) => w.length >= 3);
  const candTitleTok = normalize(cand.title).split(/\s+/).filter((w) => w.length >= 3);
  for (const w of currTitleTok) {
    if (candTitleTok.includes(w)) score += 0.5;
  }
  return score;
}

type Props = { song: SongFile };
const { song } = Astro.props;
if (!song) {
  return Astro.redirect('/404');
}
const rawBody = song.rawBody;

const initial = parseAndTranspose(rawBody, 0);
const title = initial.metadata.title;
const artist = initial.metadata.artist;
const originalKey = initial.metadata.key ?? initial.key;
const tempo = initial.metadata.tempo;
const timeSig = initial.metadata.time;
const lyricsText = extractLyricsText(rawBody);
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);

const firstLine = lyricsText.split('\n').find((l) => l.trim().length > 0) ?? title;
const description = `${title} by ${artist}${originalKey ? ` · Key: ${originalKey}` : ''}. Chords & lyrics on WokChords — ${firstLine.trim().slice(0, 120)}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicComposition',
  name: title,
  author: {
    '@type': 'Person',
    name: artist,
  },
  byArtist: {
    '@type': 'MusicGroup',
    name: artist,
  },
  inLanguage: 'en',
  url: pageUrl.toString(),
  ...(originalKey ? { musicalKey: originalKey } : {}),
  ...(tempo ? { tempo } : {}),
  ...(timeSig ? { timeSignature: timeSig } : {}),
  lyricist: {
    '@type': 'Person',
    name: artist,
  },
  lyrics: {
    '@type': 'CreativeWork',
    text: lyricsText.slice(0, 4000),
  },
  publisher: {
    '@type': 'Organization',
    name: 'WokChords',
  },
  isAccessibleForFree: true,
  keywords: ['chords', 'lyrics', 'guitar', 'piano', 'ukulele', 'music', 'song', artist, title].join(', '),
};

const tags = song.data.tags ?? [];

const allSongs = await ALL_SONGS;
const related = allSongs
  .map((s) => ({ s, score: scoreRelated(song, s) }))
  .filter((x) => x.score >= 0)
  .sort((a, b) => b.score - a.score || a.s.title.localeCompare(b.s.title))
  .slice(0, 6)
  .map((x) => x.s);

const fallback = allSongs
  .filter((s) => s.slug !== song.slug)
  .sort(() => Math.random() - 0.5)
  .slice(0, Math.max(0, 6 - related.length));
const relatedSongs = [...related, ...fallback].slice(0, 6);
---

<BaseLayout title={`${title} — ${artist}`} description={description}>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />

  <div class="max-w-[90rem] mx-auto px-3 md:px-5 py-3 md:py-5">
    <div class="grid grid-cols-12 gap-3 lg:gap-4 xl:gap-5">
      <aside class="hidden xl:block xl:col-span-2 order-first" aria-label="Advertisement">
        <div class="sticky top-16 space-y-6">
          <div
            class="w-full min-h-[280px] rounded-xl border border-dashed border-black/10 dark:border-white/10 bg-black/[0.02] dark:bg-white/[0.02]"
            data-adsense-slot="left-sidebar"
          />
        </div>
      </aside>

      <article class="col-span-12 xl:col-span-8 order-2 min-w-0">
        <header class="mb-3 md:mb-5">
          <div class="flex items-center gap-2 mb-2">
            <a
              href="/"
              class="text-xs uppercase tracking-wider text-wok-muted hover:text-wok-accent transition-colors"
            >
              ← All Songs
            </a>
          </div>
          <h1 class="text-2xl md:text-4xl font-extrabold tracking-tight leading-tight mb-1">
            {title}
          </h1>
          <p class="text-sm md:text-lg text-wok-muted mb-3">
            {artist}
          </p>
          <div class="flex flex-wrap gap-1.5 md:gap-2 items-center">
            {originalKey && (
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-wok-accent/10 text-wok-accent border border-wok-accent/30 text-xs font-semibold">
                Key {originalKey}
              </span>
            )}
            {tempo && (
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 text-wok-muted text-xs font-medium">
                {tempo} BPM
              </span>
            )}
            {timeSig && (
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 text-wok-muted text-xs font-medium">
                {timeSig}
              </span>
            )}
            {tags.map((tag) => (
              <span
                key={tag}
                class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-purple-500/10 text-purple-300 border border-purple-500/20 text-xs font-medium capitalize"
              >
                {tag}
              </span>
            ))}
          </div>
        </header>

        <InteractiveControls
          client:load
          rawText={rawBody}
          initialKey={originalKey}
          mountId="chord-sheet-mount"
          scrollTargetSelector="#chord-sheet"
        />

        <div
          id="chord-sheet"
          class="mt-4 md:mt-5 px-4 md:px-6 py-4 md:py-5 rounded-2xl bg-wok-panel/40 border border-black/5 dark:border-white/5 max-h-[85vh] overflow-y-auto overscroll-contain shadow-inner"
        >
          <div id="chord-sheet-mount" class="chordsheetjs space-y-0.5" set:html={initial.html}></div>
        </div>

        <noscript>
          <style is:global>
            #chord-sheet-mount .chord { color: #22d3ee; font-weight: 700; font-family: ui-monospace, monospace; }
            #chord-sheet-mount .lyrics, #chord-sheet-mount .lyric { color: #e5e7eb; }
          </style>
        </noscript>

        <aside class="mt-6 xl:hidden" aria-label="Advertisement">
          <div
            class="w-full min-h-[120px] rounded-xl border border-dashed border-black/10 dark:border-white/10 bg-black/[0.02] dark:bg-white/[0.02]"
            data-adsense-slot="mobile-inline"
          />
        </aside>

        <footer class="mt-5 md:mt-7 pt-4 md:pt-5 border-t border-black/5 dark:border-white/5">
          <dl class="grid grid-cols-2 sm:grid-cols-4 gap-3 md:gap-4 text-xs md:text-sm">
            {originalKey && (
              <div>
                <dt class="text-wok-muted">Key</dt>
                <dd class="font-mono font-semibold text-wok-chord">{originalKey}</dd>
              </div>
            )}
            {tempo && (
              <div>
                <dt class="text-wok-muted">Tempo</dt>
                <dd class="font-mono font-semibold">{tempo} BPM</dd>
              </div>
            )}
            {timeSig && (
              <div>
                <dt class="text-wok-muted">Time</dt>
                <dd class="font-mono font-semibold">{timeSig}</dd>
              </div>
            )}
            {tags.length > 0 && (
              <div class="col-span-2 sm:col-span-1">
                <dt class="text-wok-muted">Tags</dt>
                <dd class="font-semibold truncate">{tags.slice(0, 3).join(' · ')}</dd>
              </div>
            )}
          </dl>
        </footer>
      </article>

      <aside class="col-span-12 xl:col-span-2 order-3" aria-label="Related Songs">
        <div class="xl:sticky xl:top-16 space-y-3 md:space-y-4">
          <div class="rounded-2xl border border-black/5 dark:border-white/5 bg-wok-panel/30 p-3 md:p-4">
            <h2 class="text-xs font-bold uppercase tracking-widest text-wok-muted mb-3">
              More
            </h2>
            <ul class="space-y-2 md:space-y-2.5">
              {relatedSongs.map((r) => (
                <li>
                  <a
                    href={`/song/${r.slug}/`}
                    class="group block rounded-xl p-2 -mx-1 transition hover:bg-black/[0.04] dark:hover:bg-white/[0.04]"
                  >
                    <div class="flex items-start gap-2.5">
                      <div class="mt-0.5 h-7 w-7 shrink-0 rounded-lg bg-wok-accent/15 text-wok-accent flex items-center justify-center text-xs font-bold group-hover:bg-wok-accent group-hover:text-white transition">
                        {r.title.charAt(0)}
                      </div>
                      <div class="min-w-0 flex-1">
                        <div class="text-xs md:text-sm font-semibold text-wok-text truncate group-hover:text-wok-accent transition">
                          {r.title}
                        </div>
                        <div class="mt-0.5 text-[11px] md:text-xs text-wok-muted truncate">
                          {r.artist}
                        </div>
                        <div class="mt-1 flex flex-wrap gap-1">
                          {r.key && (
                            <span class="rounded bg-wok-chord/10 px-1.5 py-0.5 font-mono text-[9px] font-bold text-wok-chord">
                              {r.key}
                            </span>
                          )}
                          {r.tags?.slice(0, 2).map((t) => (
                            <span
                              key={t}
                              class="rounded bg-white/5 px-1.5 py-0.5 text-[9px] capitalize text-wok-muted/80"
                            >
                              #{t}
                            </span>
                          ))}
                        </div>
                      </div>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
            <div class="mt-3 pt-3 border-t border-black/5 dark:border-white/5">
              <a
                href="/"
                class="flex items-center justify-center gap-1 text-[11px] font-semibold text-wok-accent hover:underline"
              >
                Browse all songs →
              </a>
            </div>
          </div>

          <div
            class="hidden lg:block rounded-2xl border border-dashed border-black/10 dark:border-white/10 bg-black/[0.02] dark:bg-white/[0.02] min-h-[250px]"
            data-adsense-slot="right-sidebar"
          />
        </div>
      </aside>
    </div>
  </div>

  <style is:global>
    #chord-sheet-mount .chord {
      color: rgb(var(--wok-chord));
      font-weight: 700;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.875rem;
      line-height: 1.2;
    }
    @media (min-width: 768px) {
      #chord-sheet-mount .chord { font-size: 1rem; }
    }
    #chord-sheet-mount .lyrics, #chord-sheet-mount .lyric {
      color: rgb(var(--wok-text));
      font-size: 1rem;
      line-height: 1.5;
      white-space: pre-wrap;
    }
    @media (min-width: 768px) {
      #chord-sheet-mount .lyrics, #chord-sheet-mount .lyric { font-size: 1.125rem; }
    }
    #chord-sheet-mount .comment, #chord-sheet-mount .label {
      text-transform: uppercase;
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      font-weight: 600;
      color: rgb(var(--wok-muted));
      margin: 1rem 0 0.4rem;
      padding-left: 0.6rem;
      border-left: 2px solid rgb(var(--wok-accent));
    }
    @media (min-width: 768px) {
      #chord-sheet-mount .comment, #chord-sheet-mount .label { font-size: 0.75rem; }
    }
    #chord-sheet-mount .row {
      margin-bottom: 0.35rem;
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      row-gap: 0.5rem;
    }
    #chord-sheet-mount .column {
      display: inline-flex;
      flex-direction: column;
      vertical-align: bottom;
    }
    #chord-sheet-mount .verse, #chord-sheet-mount .chorus,
    #chord-sheet-mount .bridge, #chord-sheet-mount .tab,
    #chord-sheet-mount .indeterminate {
      margin-bottom: 1rem;
    }
    @media (min-width: 768px) {
      #chord-sheet-mount .verse, #chord-sheet-mount .chorus,
      #chord-sheet-mount .bridge, #chord-sheet-mount .tab,
      #chord-sheet-mount .indeterminate {
        margin-bottom: 1.25rem;
      }
    }
  </style>
</BaseLayout>
