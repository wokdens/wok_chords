---
import { getAllSongs } from '../../lib/songStore';

export const prerender = true;

export async function getStaticPaths() {
  const songs = getAllSongs();
  const movieMap = new Map<string, { title: string; slug: string }>();

  for (const song of songs) {
    if (song.movie && song.movieSlug) {
      if (!movieMap.has(song.movieSlug)) {
        movieMap.set(song.movieSlug, {
          title: song.movie,
          slug: song.movieSlug,
        });
      }
    }
  }

  return Array.from(movieMap.values()).map((movie) => ({
    params: { slug: movie.slug },
    props: {
      title: movie.title,
      slug: movie.slug,
    },
  }));
}

interface Props {
  title: string;
  slug: string;
}

const { title, slug } = Astro.props;
const targetUrl = `/movie/${slug}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Redirecting to {title} Soundtrack — WokChords</title>
    <link rel="canonical" href={`https://wokchords.wokdens.com${targetUrl}`} />
    <meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
    <meta name="robots" content="noindex,follow" />
  </head>
  <body style="font-family: system-ui, sans-serif; text-align: center; padding: 40px;">
    <p>Redirecting to <a href={targetUrl}>{title} Soundtrack Chords</a>...</p>
    <script define:vars={{ targetUrl }}>
      window.location.replace(targetUrl);
    </script>
  </body>
</html>
