---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllSongs, type SongItem } from '../../lib/songStore';

export const prerender = true;

const songs = getAllSongs();

interface MovieData {
  title: string;
  slug: string;
  songs: SongItem[];
}

const movieMap = new Map<string, MovieData>();

for (const s of songs) {
  if (s.movie && s.movieSlug) {
    if (!movieMap.has(s.movieSlug)) {
      movieMap.set(s.movieSlug, {
        title: s.movie,
        slug: s.movieSlug,
        songs: [],
      });
    }
    movieMap.get(s.movieSlug)!.songs.push(s);
  }
}

const allMovies = Array.from(movieMap.values())
  .filter((m) => m.songs.length > 0)
  .sort((a, b) => b.songs.length - a.songs.length || a.title.localeCompare(b.title));

const baseUrl = 'https://wokchords.wokdens.com';
const pageTitle = "Movie Soundtracks & Album Chords | WokChords";
const pageDescription = "Browse guitar, piano, and ukulele chords for popular Bollywood and cinema movie soundtracks on WokChords. Full album chord listings with transpose and auto-scroll.";

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${baseUrl}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Soundtracks',
      item: `${baseUrl}/movies/`,
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <section class="max-w-[90rem] mx-auto px-3 md:px-5 pt-5 md:pt-8 pb-3 md:pb-4">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 pb-4 border-b border-black/5 dark:border-white/5">
      <div>
        <nav class="flex items-center gap-2 text-xs text-wok-muted mb-1" aria-label="Breadcrumb">
          <a href="/" class="hover:text-wok-accent">Home</a>
          <span>/</span>
          <span class="text-wok-text font-semibold">Soundtracks</span>
        </nav>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight text-wok-text">
          Movie Soundtracks & Albums
        </h1>
        <p class="mt-1 text-xs md:text-sm text-wok-muted">
          Browse chords by film and album soundtracks · {allMovies.length} albums available
        </p>
      </div>
    </div>
  </section>

  <section class="max-w-[90rem] mx-auto px-3 md:px-5 pb-16 md:pb-24">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {allMovies.map(({ title, slug, songs }) => (
        <div class="rounded-2xl border border-black/5 dark:border-white/5 bg-white/75 dark:bg-slate-900/60 backdrop-blur-md hover:bg-white/95 dark:hover:bg-slate-900/90 hover:border-orange-500/40 hover:-translate-y-1 transition-all duration-200 shadow-sm hover:shadow-xl hover:shadow-orange-500/10 p-5 flex flex-col justify-between">
          <div>
            <div class="flex items-start justify-between gap-2 mb-3 pb-3 border-b border-black/5 dark:border-white/5">
              <div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-wok-accent">Movie Soundtrack</span>
                <h2 class="text-lg font-bold text-wok-text">
                  <a href={`/movie/${slug}/`} class="hover:text-wok-accent transition-colors">
                    {title}
                  </a>
                </h2>
              </div>
              <span class="shrink-0 px-2.5 py-1 rounded-lg bg-black/5 dark:bg-white/5 text-wok-muted text-xs font-semibold">
                {songs.length} {songs.length === 1 ? 'song' : 'songs'}
              </span>
            </div>

            <div class="space-y-1.5 mb-4">
              {songs.slice(0, 5).map((s) => (
                <a
                  href={`/song/${s.slug}/`}
                  class="group flex items-center justify-between p-2 rounded-lg hover:bg-wok-panel transition-colors text-xs"
                >
                  <span class="font-medium text-wok-text group-hover:text-wok-accent truncate pr-2">
                    {s.title}
                  </span>
                  {s.key && (
                    <span class="shrink-0 px-1.5 py-0.2 rounded bg-wok-chord/10 text-wok-chord text-[10px] font-mono font-bold">
                      {s.key}
                    </span>
                  )}
                </a>
              ))}
            </div>
          </div>

          <a
            href={`/movie/${slug}/`}
            class="pt-3 border-t border-black/5 dark:border-white/5 text-xs font-bold text-wok-accent hover:underline flex items-center justify-between mt-auto"
          >
            <span>View Full {title} Album ({songs.length} Tracks)</span>
            <span>→</span>
          </a>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
