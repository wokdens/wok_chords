---
import BaseLayout from '../layouts/BaseLayout.astro';
import AlphabetNav from '../components/AlphabetNav.tsx';
import { getAllSongs } from '../lib/songStore';

export const prerender = true;

const songs = getAllSongs();

const groups = songs.reduce<Record<string, typeof songs>>((acc, s) => {
  const title = s.title.trim();
  const firstChar = title.charAt(0).toUpperCase();
  const letter = /^[A-Z]$/.test(firstChar) ? firstChar : '#';
  (acc[letter] ||= []).push(s);
  return acc;
}, {});

const letters = Object.keys(groups).sort((a, b) => {
  if (a === '#') return 1;
  if (b === '#') return -1;
  return a.localeCompare(b);
});
---

<BaseLayout
  title="All Songs Directory (A–Z) — Chords & Lyrics"
  description="Browse guitar, piano, and ukulele chords for over 4,000 songs arranged from A to Z on WokChords."
>
  <section class="max-w-[90rem] mx-auto px-3 md:px-5 pt-5 md:pt-8 pb-3 md:pb-4">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 pb-4 border-b border-black/5 dark:border-white/5">
      <div>
        <div class="flex items-center gap-2 text-xs text-wok-muted mb-1">
          <a href="/" class="hover:text-wok-accent">Home</a>
          <span>/</span>
          <span class="text-wok-text font-semibold">All Songs</span>
        </div>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight text-wok-text">
          All Songs Directory (A–Z)
        </h1>
        <p class="mt-1 text-xs md:text-sm text-wok-muted">
          {songs.length.toLocaleString()} chord sheets · click any letter to jump or use search above
        </p>
      </div>
      <div class="text-xs text-wok-muted flex items-center gap-2">
        <span>Quick search:</span>
        <kbd class="font-mono px-2 py-0.5 rounded bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 text-xs font-semibold">/</kbd>
      </div>
    </div>
  </section>

  <section class="max-w-[90rem] w-full mx-auto px-3 md:px-5 pb-16 md:pb-24 min-w-0">
    <div class="grid grid-cols-1 md:grid-cols-[minmax(0,auto)_minmax(0,1fr)] gap-4 md:gap-8 w-full min-w-0">
      <aside class="md:sticky md:top-[90px] md:self-start md:h-fit order-2 md:order-1 min-w-0">
        <div class="flex md:flex-col items-start gap-1.5 overflow-x-auto max-w-full pb-2 md:pb-0">
          <AlphabetNav client:idle letters={letters} />
        </div>
      </aside>

      <div class="min-w-0 order-1 md:order-2 w-full">
        {letters.map((letter) => (
          <section id={`letter-${letter}`} class="scroll-mt-24 mb-8 md:mb-10 last:mb-0 w-full min-w-0">
            <div class="flex items-center gap-2 mb-3 min-w-0">
              <span class="inline-flex items-center justify-center w-8 h-8 rounded-xl bg-wok-accent text-white font-black text-sm shrink-0">
                {letter}
              </span>
              <span class="text-wok-muted text-xs font-semibold shrink-0">{groups[letter].length} songs</span>
              <div class="flex-1 h-px bg-black/10 dark:border-white/10"></div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5 w-full min-w-0">
              {groups[letter].map(({ slug, title, artist, key, tags, snippet }) => (
                <a
                  href={`/song/${slug}/`}
                  class="group flex flex-col justify-between rounded-xl border border-black/5 dark:border-white/5 bg-white/75 dark:bg-slate-900/60 backdrop-blur-md hover:bg-white/95 dark:hover:bg-slate-900/90 transition-all p-3.5 hover:border-orange-500/40 hover:-translate-y-1 duration-150 shadow-sm hover:shadow-lg hover:shadow-orange-500/10 w-full min-w-0 overflow-hidden"
                >
                  <div class="min-w-0 mb-1.5">
                    <div class="flex items-start justify-between gap-2">
                      <h3 class="text-sm font-bold text-wok-text group-hover:text-wok-accent transition-colors truncate">
                        {title}
                      </h3>
                      {key && (
                        <span class="shrink-0 px-1.5 py-0.2 rounded bg-wok-chord/10 text-wok-chord border border-wok-chord/20 text-[10px] font-mono font-bold">
                          {key}
                        </span>
                      )}
                    </div>
                    <p class="text-wok-muted text-xs truncate mt-0.5">
                      {artist}
                    </p>
                  </div>

                  {snippet && (
                    <p class="text-[11px] text-wok-muted/80 italic leading-snug truncate mb-2">
                      “{snippet}”
                    </p>
                  )}

                  <div class="flex items-center justify-between text-[10px] pt-1 border-t border-black/5 dark:border-white/5">
                    <div class="flex gap-1 truncate">
                      {tags.slice(0, 1).map((tag: string) => (
                        <span key={tag} class="text-wok-muted capitalize">
                          #{tag}
                        </span>
                      ))}
                    </div>
                    <span class="text-wok-muted group-hover:text-wok-accent font-semibold ml-auto">
                      Play →
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
