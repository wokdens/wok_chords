---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { slugify } from '../../lib/slugify';
import { getAllSongs, type SongItem } from '../../lib/songStore';

export const prerender = true;

export async function getStaticPaths() {
  const songs = getAllSongs();
  const tagMap = new Map<string, { tagName: string; songs: SongItem[] }>();

  for (const song of songs) {
    for (const t of song.tags) {
      const cleanTag = String(t).trim();
      if (!cleanTag) continue;
      const tagSlug = slugify(cleanTag);
      if (!tagMap.has(tagSlug)) {
        tagMap.set(tagSlug, { tagName: cleanTag, songs: [] });
      }
      tagMap.get(tagSlug)!.songs.push(song);
    }
  }

  return Array.from(tagMap.entries()).map(([slug, { tagName, songs }]) => ({
    params: { slug },
    props: {
      tagName,
      tagSlug: slug,
      songs,
      allTagsList: Array.from(tagMap.entries()).map(([s, val]) => ({
        slug: s,
        name: val.tagName,
        count: val.songs.length,
      })),
    },
  }));
}

interface Props {
  tagName: string;
  tagSlug: string;
  songs: SongItem[];
  allTagsList: Array<{ slug: string; name: string; count: number }>;
}

const { tagName, tagSlug, songs, allTagsList } = Astro.props;

const enriched = songs.map((song) => {
  return {
    slug: song.slug,
    title: song.title || 'Untitled',
    artist: song.artist || 'Unknown Artist',
    key: song.key,
    tags: song.tags ?? [],
    snippet: song.snippet,
  };
});

enriched.sort((a, b) => a.title.localeCompare(b.title));

const otherTags = allTagsList
  .filter((t) => t.slug !== tagSlug)
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const pageTitle = `${tagName.toUpperCase()} Song Chords & Lyrics | Guitar & Piano Tabs`;
const pageDescription = `Play ${tagName} songs on Guitar, Ukulele and Piano with accurate chords, transpose, and lyrics on WokChords.`;
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', Astro.site ?? Astro.url).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Category',
      item: new URL('/', Astro.site ?? Astro.url).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: tagName,
      item: pageUrl.toString(),
    },
  ],
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <div class="max-w-7xl mx-auto px-3 sm:px-5 py-5 md:py-8">
    <nav class="flex items-center gap-2 text-xs text-wok-muted mb-4 uppercase tracking-wider font-semibold">
      <a href="/" class="hover:text-wok-accent transition-colors">Home</a>
      <span>/</span>
      <span class="text-wok-accent">Category</span>
      <span>/</span>
      <span class="text-wok-text capitalize truncate">{tagName}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8">
      <main class="lg:col-span-8 xl:col-span-9 min-w-0">
        <header class="mb-6 pb-4 border-b border-black/5 dark:border-white/5">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-12 h-12 rounded-2xl bg-purple-500/15 text-purple-400 flex items-center justify-center text-xl font-black">
              #
            </div>
            <div>
              <h1 class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight text-wok-text capitalize">
                {tagName} Songs
              </h1>
              <p class="text-xs sm:text-sm text-wok-muted mt-0.5">
                {songs.length} song{songs.length === 1 ? '' : 's'} tagged with #{tagName}
              </p>
            </div>
          </div>
        </header>

        <div class="grid gap-3.5 sm:grid-cols-2">
          {enriched.map(({ slug, title, artist, key, snippet }) => (
            <a
              href={`/song/${slug}/`}
              class="group block rounded-2xl border border-black/5 dark:border-white/5 bg-wok-panel/40 hover:bg-wok-panel/80 transition-all p-4 shadow-md hover:border-wok-accent/40 hover:-translate-y-0.5 duration-150"
            >
              <div class="flex items-start justify-between gap-2.5 mb-2">
                <div class="min-w-0">
                  <h2 class="text-base sm:text-lg font-bold tracking-tight text-wok-text group-hover:text-wok-accent transition-colors truncate">
                    {title}
                  </h2>
                  <p class="text-wok-muted text-xs truncate mt-0.5">
                    {artist}
                  </p>
                </div>
                {key && (
                  <span class="shrink-0 inline-flex items-center px-2 py-0.5 rounded-md bg-wok-chord/10 text-wok-chord border border-wok-chord/30 text-[11px] font-mono font-bold">
                    Key {key}
                  </span>
                )}
              </div>

              {snippet && (
                <p class="text-xs text-wok-muted/90 italic leading-relaxed line-clamp-2 mb-3 pl-2 border-l-2 border-black/10 dark:border-white/10">
                  “{snippet}…”
                </p>
              )}

              <div class="flex items-center justify-between text-[11px] pt-1">
                <span class="text-wok-accent font-medium capitalize">
                  #{tagName}
                </span>
                <span class="text-wok-muted/80 group-hover:text-wok-accent font-semibold inline-flex items-center gap-1">
                  Play Chords →
                </span>
              </div>
            </a>
          ))}
        </div>
      </main>

      <aside class="lg:col-span-4 xl:col-span-3">
        <div class="lg:sticky lg:top-16 space-y-4">
          <div class="rounded-2xl border border-black/5 dark:border-white/5 bg-wok-panel/30 p-4">
            <h3 class="text-xs font-bold uppercase tracking-widest text-wok-muted mb-3">
              All Categories
            </h3>
            <ul class="space-y-1.5">
              {otherTags.map((t) => (
                <li>
                  <a
                    href={`/tag/${t.slug}/`}
                    class="flex items-center justify-between p-2 rounded-xl text-xs font-semibold text-wok-text hover:bg-black/5 dark:hover:bg-white/5 hover:text-wok-accent transition capitalize"
                  >
                    <span class="truncate">#{t.name}</span>
                    <span class="text-[10px] font-mono text-wok-muted px-1.5 py-0.5 rounded bg-black/5 dark:bg-white/5">
                      {t.count}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
