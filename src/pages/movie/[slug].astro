---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllSongs, type SongItem } from '../../lib/songStore';
import { slugify } from '../../lib/slugify';

export const prerender = true;

export async function getStaticPaths() {
  const songs = getAllSongs();
  const movieMap = new Map<string, { title: string; slug: string; songs: SongItem[] }>();

  for (const song of songs) {
    if (song.movie && song.movieSlug) {
      if (!movieMap.has(song.movieSlug)) {
        movieMap.set(song.movieSlug, {
          title: song.movie,
          slug: song.movieSlug,
          songs: [],
        });
      }
      movieMap.get(song.movieSlug)!.songs.push(song);
    }
  }

  return Array.from(movieMap.values()).map((movie) => ({
    params: { slug: movie.slug },
    props: {
      title: movie.title,
      slug: movie.slug,
      songs: movie.songs,
    },
  }));
}

interface Props {
  title: string;
  slug: string;
  songs: SongItem[];
}

const { title, slug, songs } = Astro.props;

// Find unique artists in this soundtrack
const artists = Array.from(new Set(songs.map((s) => s.artist).filter(Boolean)));
const baseUrl = 'https://wokchords.wokdens.com';
const pageCanonical = `${baseUrl}/movie/${slug}/`;

const pageTitle = `${title} Movie Soundtrack Guitar Chords & Songs | WokChords`;
const pageDescription = `Play guitar, ukulele, and piano chords for all songs from the ${title} soundtrack (${songs.length} tracks) on WokChords. Includes pitch transpose, capo tool, and auto-scroll.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'MusicAlbum',
      name: `${title} (Original Motion Picture Soundtrack)`,
      url: pageCanonical,
      numTracks: songs.length,
      track: songs.map((s, idx) => ({
        '@type': 'MusicRecording',
        position: idx + 1,
        name: s.title,
        url: `${baseUrl}/song/${s.slug}/`,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: `${baseUrl}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Soundtracks',
          item: `${baseUrl}/movies/`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: title,
          item: pageCanonical,
        },
      ],
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="max-w-5xl w-full mx-auto px-4 sm:px-6 pt-6 sm:pt-10 pb-16 sm:pb-24 min-w-0">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-wok-muted mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-wok-accent">Home</a>
      <span>/</span>
      <a href="/movies/" class="hover:text-wok-accent">Soundtracks</a>
      <span>/</span>
      <span class="text-wok-text font-semibold truncate">{title}</span>
    </nav>

    <!-- Header Card -->
    <header class="rounded-3xl border border-black/10 dark:border-white/10 bg-wok-panel/50 p-6 sm:p-10 mb-10 shadow-sm relative overflow-hidden w-full">
      <div class="absolute -top-12 -right-12 w-48 h-48 rounded-full bg-wok-accent/10 blur-3xl pointer-events-none"></div>
      <div class="relative z-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-wok-accent/10 text-wok-accent text-xs font-bold uppercase tracking-wider mb-3">
          🎬 Movie Soundtrack Album
        </div>
        <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-wok-text mb-3">
          {title} <span class="text-wok-accent text-xl sm:text-3xl font-extrabold block sm:inline">Soundtrack Guitar Chords</span>
        </h1>
        <p class="text-xs sm:text-sm text-wok-muted max-w-2xl leading-relaxed mb-4">
          Verified guitar and piano chords for all {songs.length} tracks in {title}, featuring music by {artists.slice(0, 4).join(', ')}{artists.length > 4 ? ', and more' : ''}. Free interactive playback with key transpose and auto-scroll.
        </p>
        <div class="flex flex-wrap items-center gap-3 text-xs">
          <span class="px-3 py-1 rounded-xl bg-black/5 dark:bg-white/5 font-semibold text-wok-text">
            🎵 {songs.length} {songs.length === 1 ? 'Track' : 'Tracks'}
          </span>
          <span class="px-3 py-1 rounded-xl bg-black/5 dark:bg-white/5 font-semibold text-wok-text">
            ⚡ 1-Click Transpose Available
          </span>
        </div>
      </div>
    </header>

    <!-- Song List Grid -->
    <div class="w-full min-w-0">
      <h2 class="text-xl sm:text-2xl font-bold text-wok-text mb-4">
        Songs in {title}
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 w-full min-w-0">
        {songs.map((s, index) => (
          <a
            href={`/song/${s.slug}/`}
            class="group flex items-center justify-between p-4 rounded-2xl border border-black/5 dark:border-white/5 bg-wok-panel/30 hover:bg-wok-panel/90 hover:border-wok-accent/40 hover:-translate-y-0.5 transition-all shadow-sm duration-150 w-full min-w-0 overflow-hidden"
          >
            <div class="flex items-center gap-3.5 min-w-0 pr-2">
              <span class="w-8 h-8 rounded-xl bg-black/5 dark:bg-white/5 text-wok-muted group-hover:bg-wok-accent group-hover:text-white font-bold text-xs flex items-center justify-center shrink-0 transition-colors">
                {index + 1}
              </span>
              <div class="min-w-0">
                <h3 class="font-bold text-sm text-wok-text group-hover:text-wok-accent transition-colors truncate">
                  {s.title}
                </h3>
                <p class="text-xs text-wok-muted truncate">
                  {s.artist}
                </p>
              </div>
            </div>

            <div class="flex items-center gap-2 shrink-0">
              {s.key && (
                <span class="px-2 py-0.5 rounded bg-wok-chord/10 text-wok-chord border border-wok-chord/20 text-[10px] font-mono font-bold">
                  Key {s.key}
                </span>
              )}
              <span class="text-wok-muted group-hover:text-wok-accent font-semibold text-xs ml-1">
                Play →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
