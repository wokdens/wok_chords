---
import '../styles/global.css';
import SearchBar from '../components/SearchBar.tsx';
import ThemeToggle from '../components/ThemeToggle.tsx';

interface Props {
  title: string;
  description?: string;
  hideSearch?: boolean;
}

const { title, description = 'WokChords — Chord & Lyrics platform with transpose, auto-scroll, and SEO-first static pages.', hideSearch = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" type="image/svg+xml" href="/apple-touch-icon.svg" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ea580c" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0f17" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="WokChords" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet" />
    <title>{title} — WokChords</title>
    <script is:inline>
      (function () {
        try {
          var key = 'wokchords-theme';
          var stored = localStorage.getItem(key);
          var dark = false;
          if (stored === 'dark' || stored === 'light') {
            dark = stored === 'dark';
          } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
            dark = true;
          }
          var root = document.documentElement;
          if (dark) root.classList.add('dark');
          else root.classList.remove('dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-30 backdrop-blur-md bg-wok-bg/80 border-b border-black/5 dark:border-white/5">
      <div class="max-w-[90rem] mx-auto px-3 md:px-5 py-2 flex items-center gap-2 md:gap-3">
        <a href="/" class="flex items-center gap-1.5 group shrink-0">
          <span class="text-xl md:text-2xl group-hover:rotate-6 transition-transform inline-block">🎸</span>
          <span class="font-bold text-base md:text-lg tracking-tight hidden sm:inline">
            Wok<span class="text-wok-accent">Chords</span>
          </span>
        </a>
        {!hideSearch && (
          <div class="flex-1 flex justify-end min-w-0">
            <SearchBar client:load />
          </div>
        )}
        {hideSearch && <div class="flex-1" />}
        <ThemeToggle client:idle />
        <nav class="text-xs md:text-sm text-wok-muted hover:text-wok-text transition-colors shrink-0">
          <a href="/" class="hover:text-wok-accent whitespace-nowrap">All Songs</a>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="mt-10 md:mt-14 border-t border-black/5 dark:border-white/5 py-5 md:py-6">
      <div class="max-w-[90rem] mx-auto px-3 md:px-5 text-center text-wok-muted text-[11px] md:text-xs">
        <p>© {new Date().getFullYear()} WokChords</p>
      </div>
    </footer>
  </body>
</html>
