---
import '../styles/global.css';
import SearchBar from '../components/SearchBar.tsx';

interface Props {
  title: string;
  description?: string;
  hideSearch?: boolean;
}

const { title, description = 'WokChords — Chord & Lyrics platform with transpose, auto-scroll, and SEO-first static pages.', hideSearch = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%8E%B8%3C/text%3E%3C/svg%3E" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <title>{title} — WokChords</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-30 backdrop-blur-md bg-wok-bg/80 border-b border-white/5">
      <div class="max-w-7xl mx-auto px-4 md:px-6 py-3 flex items-center gap-4">
        <a href="/" class="flex items-center gap-2 group shrink-0">
          <span class="text-2xl group-hover:rotate-6 transition-transform inline-block">🎸</span>
          <span class="font-bold text-lg tracking-tight hidden sm:inline">
            Wok<span class="text-wok-accent">Chords</span>
          </span>
        </a>
        {!hideSearch && (
          <div class="flex-1 flex justify-center min-w-0">
            <SearchBar client:load />
          </div>
        )}
        {hideSearch && <div class="flex-1" />}
        <nav class="text-sm text-wok-muted hover:text-wok-text transition-colors shrink-0">
          <a href="/" class="hover:text-wok-accent whitespace-nowrap">All Songs</a>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="mt-16 border-t border-white/5 py-8">
      <div class="max-w-7xl mx-auto px-4 md:px-6 text-center text-wok-muted text-sm">
        <p>© {new Date().getFullYear()} WokChords · Built with Astro, React &amp; Tailwind</p>
      </div>
    </footer>
  </body>
</html>
