{title: Na Kajre Ki Dhar}
{artist: Mohra Pankaj Udhas}
{key: Em}

{c: Verse 1}
[Em] [D],        naa kajare kee dhaar,
[Em] [D],        naa motiyon ke haar
[C] [D],        naa koee kiyaa singaar,
[Em],        fir bhee kitanee sundar ho
[Em] [D],        man mein pyaar bharaa,
[Em] [D],        aur tan mein pyaar bharaa
[C] [D],        jeewan mein pyaar bharaa,
[Em],        tum to mere priyawar ho
[D] [Em],        singaar teraa yauwan
[Em],        yauwan hee teraa gahanaa
[D] [Em],        too taajagee foolon kee,
[Em],        kyaa saadagee ka kahanaa
[A] [Em],        ude khushaboo jab chale too,
[Em],        bole to baje sitaar
[D] [Em],        saaree duniyaan harajaaee,
[Em],        tere pyaar mein hain sachchaaee
[D] [Em],        is liye chhod ke duniyaa,
[Em],        tere or kheenchee chalee aaee
[A] [Em],        thee patthar, toone chhookar,
[Em],        sonaa kar diyaa kharaa
[D] [Em],        teraa ang sachchaa sonaa,
[Em],        muskaan sachche mote
[D] [Em],        tere honthh hain madhushaalaa,
[Em],        too rup kee hain jyoti
[A] [Em],        teree soorat jaise moorat
[Em],        main dekhoo baar baar
