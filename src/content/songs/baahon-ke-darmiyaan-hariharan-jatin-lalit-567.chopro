{title: Baahon Ke Darmiyaan}
{artist: Hariharan Jatin Lalit}
{key: A}

{c: Verse 1}
[A] [Bm],        baahon ke daramiyaan,
[A] [F#m],        do pyaar mil rahe hai
[F#m] [E],        jaane kyaa bole man
[E] [F#m],        dole sun ke badan
[F#m] [A],        dhadakan banee jubaan
[D] [A],        khulate band hote,
[A] [D],        labo kee ye anakahee
[D] [A],        muz se kah rahee hain
[A] [D],        ke badhne de bekhudee
[Bm] [E],        mil yoo ke daud jaaye,
[E] [A],        nas nas mein bijaliyaan
[D] [A],        aasamaan ko bhee ye,
[A] [D],        hasee raaj hain pasand
[D] [A],        ulazee ulazee saason kee,
[A] [D],        aawaaj hain pasand
[Bm] [E],        motee lootaa rahee hai,
[E] [A],        saawan kee badaliyaan
