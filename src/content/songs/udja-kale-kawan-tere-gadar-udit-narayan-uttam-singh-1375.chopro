{title: Udja Kale Kawan Tere}
{artist: Gadar Udit Narayan Uttam Singh}
{key: C#}

{c: Verse 1}
[C#],        Udja kale kawan tere
[G#] [C#],        muwich khandpanwa
[C#],        Le ja tu sandesha meraa,
[G#] [C#],        mai sadke jawan
[C#],        Bagon me phir jhule pad gaye
[F#] [C#],        Pak gayean mithiya ambiya
[C#] [F#],        Yeh chhotee see jindagee de
[G#] [C#],        rat lambiya lambiya
[C#],        Oh ghar aaja pardesee,
[C#],        kee teree meree ek jinddee
[C#] [G#],        Cham cham karta aaya mausam,
[F#] [C#],        pyar ke gito kaa
[C#] [G#],        Raste pe ankhiya, rasta dekhe
[F#] [C#],        bichde mito kaa
[C#],        Saree saree rat jagaye
[F#] [C#],        mujhko teree yade
[C#] [F#],        Mere sare git bane me
[G#],        re dil kee faryade
[C#],        Oh ghar aaja pardesee,
[C#],        kee teree meree ek jinddee
