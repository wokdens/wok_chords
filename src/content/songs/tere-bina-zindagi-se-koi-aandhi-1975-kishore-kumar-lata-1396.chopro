{title: Tere Bina Zindagi Se Koi}
{artist: Aandhi 1975 Kishore Kumar Lata Mangeshkar R D Burman Gulzar}
{key: Cm}

{c: Verse 1}
[Cm] [D#],        Tere bina zindagi se koi
[D#] [G#] [Fm],        shikwa to nahin Shikwa nahin,
[A#] [Cm],        shikwa nahin, shikwa nahin
[Cm] [D#],        Tere bina zindagi bhi lekin
[D#] [G#] [Fm],        zindagi to nahin Zindagi nahin,
[A#] [Cm],        zindagi nahin, zindagi nahin
[Cm] [G],        Kaash aisa ho
[G#] [D#],        tere kadmon se
[F],        chun ke manzil chale
[A#] [Cm],        Aur kahin door kahin
[A#],        Tum gar saath ho,
[F] [Cm],        manzilon ki kami to nahin
[Cm] [G],        Jee mein aata hai
[G#] [D#],        tere daaman mein
[F],        Sar chhupa ke hum
[A#] [Cm],        rote rahein, rote rahein
[A#],        Teri bhi aankhon mein
[F] [Cm],        aansuon ki nami to nahin
[Cm] [G],        Tum jo keh do to
[G#] [D#],        aaj ki raat
[F],        chaand doobega nahin
[A#] [Cm],        Raat ko rok lo
[A#],        Raat ki baat hai
[F] [Cm],        aur zindagi baaki to nahin
