{title: Tu Tenva Tashi}
{artist: Hridaynath Mangeshkar}
{key: D#}

{c: Verse 1}
[D#] [G#],        Tu.....
[A#],        tevha tashi,
[F] [A#],        tu....
[F] [D#],        tevha ashi,
[D#] [F] [A#],        tu baharanchya bahunchi
[D#] [G#],        Tu.....
[D#] [A#],        tu yel radha,
[F] [A#],        tu pail sandhya,
[D#] [F] [A#],        chafekali premachi
[D#] [G#],        Tu.....
[D#] [Cm],        tu navijuni,
[Gm] [D#],        tu kadhi kuni
[D#] [F] [A#],        kharichya ga, dolyanchi
[D#] [G#],        Tu.....
[A#] [D#] [A#],        tu harvikchhi,
[A#] [F] [A#],        tu pokta sachhi,
[D#] [F] [A#],        tu khttimithhi othanchi
[D#] [G#],        Tu.....
tu kuni pakshi pisanvar nakshi,        kavitechya ishwarachi
