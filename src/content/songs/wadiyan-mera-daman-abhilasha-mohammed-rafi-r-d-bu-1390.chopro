{title: Wadiyan Mera Daman}
{artist: Abhilasha Mohammed Rafi R D Burman}
{key: C}

{c: Verse 1}
[C],        Waadiya meraa daaman,
[G],        raaste meri baahe
[F],        Jaao mere sivaa,
[G] [C],        tum kahaan jaaoge
[C] [G],        Jab churaaoge tan
[F] [C],        tum kisi baat se
[C] [G],        Shaakh e gul chhed degi
[F] [C],        mere haath se
[C] [F],        Apani hi zulph ko
[G] [C],        aur ulajhaaoge
[C] [G],        Jabase milane lagi
[F] [C],        tumase raahe meri
[C] [G],        Chaand suraj bani
[F] [C],        do nigaahe meri
[C] [F],        Tum kahi bhi raho,
[G] [C],        tum nazar aaoge
