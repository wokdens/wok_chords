{title: Ha Khel Savalyancha}
{artist: Hridaynath Mangeshkar}
{key: C}

{c: Verse 1}
[C] [Am] [G],        Raatrich khel chhale
[C] [Am] [G],        Ya god chandnyancha
[D] [G],        Sampel na kadihi
[G] [Am] [C],        Ha khel savlyancha
[C] [Am] [G],        Ha khel savlayancha
[D] [G],        Ha khel savlyancha
[C] [G] [Em],        Ha chandra na swayambhu
[Em] [C] [F],        Ravi tej Wahatoh Haa
[F] [D],        Grahnat Chandnyancha
[F] [D] [G],        Abhishaap bhogtoh haan
[C] [Am],        Prretit mand hoi
[Am] [G],        Ha goodh chandnyancha
[C] [Am] [G],        Ha khel savlyancha
[D] [G],        Ha khel savlyancha
