{c: Verse 1}
[Dm] [F],        Khilate hain gul yahaan,
[F] [Dm],        khil ke bikharane ko
[Dm] [F],        Milate hain dil yahaan,
[Dm] [F] [Dm],        mil ke bichhadane ko
[Dm],        Khilate hain gul yahaan...
[Dm],        Kal rahe naa rahe,
[F] [Dm],        mausam ye pyaar ka
[Dm] [F],        Kal ruke na ruke,
[Am] [Dm],        dola bahaar ka
[F],        Chaar pal mile jo aaj,
[G] [Dm],        pyaar men guzaar de
[Dm],        Jhilon ke honthon par,
[F] [Dm],        meghon ka raag hai
[Dm],        Phoolon ke seene men,
[Am] [Dm],        thandi-thandi aag hai
[F],        Dil ke aaine men tu,
[G] [Dm],        ye sama utaar de
[Dm],        Pyaasa hai dil sanam,
[F] [Dm],        pyaasi ye raat hai
[Dm],        Honthon me dabi-dabi,
[Am] [F],        koi mithi baat hai
[F],        In lamhon pe aaj tu,
[G] [Dm],        har khushi nisaar de
