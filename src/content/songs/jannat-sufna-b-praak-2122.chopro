{title: Jannat}
{artist: Sufna B Praak}
{key: Em}

{c: Verse 1}
[Em] [D],        Tera hasna vi jannat ae
[C] [Em],        Tera taveez jannat ae
[Em] [D],        Tera hansna vi jannat ae
[C] [Em],        Tera taveez jannat ae
[Em] [D],        Ho jannat hai tera mukhda
[C] [Em],        Teri har cheez jannat ae
[Em] [D],        Ho jannat ae tera mukhda
[C] [Em],        Teri har cheez jannat ae
[Em] [Bm],        Ho tere pair vi jannat ae
[Bm] [Em],        Ho tere sheher vi jannat ae
[Em] [Bm],        Ho assi pee jaane ikko saah
[Bm] [Em],        Tere zehar vi jannat ae
[Em] [D],        Ho jannat ae teri galliyan
[C] [Em],        Teri dehleez jannat ae
[Em] [Bm],        Ho jannat ae tera hasna
[C] [Em],        Teri har cheez jannat ae
[Em],        Hun tere bin namumkin
[Em] [D],        Karna guzara ho gaya
[D],        Allah di kasam Allah di kasam
[D] [Em],        Tu mainu enna pyara ho gaya
[Em] [Bm],        Tera ladna vi jannat ae
[C] [Em],        Teri tameez jannat ae
[Em] [Bm],        Ho jannat ae tera hasna
[C] [Em],        Teri har cheez jannat ae
[Em],        Ho sarheya nahi, mareya nahi
[Em] [D],        Dupptta tera jinnu chhu gaya
[D],        Tu chummeya si jo parinda kade o
[Em],        Main sohneya amar ho gaya
[Em] [Bm],        Teri jhanjhar vi jannat ae
[C] [Em],        Teri kameez jannat ae
[Em] [Bm],        Ho jannat ae tera hasna
