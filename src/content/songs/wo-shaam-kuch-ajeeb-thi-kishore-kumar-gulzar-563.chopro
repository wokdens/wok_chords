{title: Wo Shaam Kuch Ajeeb Thi}
{artist: Kishore Kumar Gulzar}
{key: G}

{c: Verse 1}
[G] [C],        Wo shaam kuchh ajeeb thi
[G] [C],        ye shaam bhi ajeeb hai
[F] [C],        Wo kal bhi paas paas thi woh
[G] [C],        aaj bhi kareeb hain
[G] [C],        Wo shaam kuchh ajeeb thi
[G] [C],        Jhukii hui nigaahon mein
[G] [C],        kahin mera khayal tha
[G] [C],        Dabi dabi hansii mein ek
[G] [C],        haseen sa gulaal tha
[F] [C],        Main sochtaa tha, mera naam
[C] [F],        gunguna rahi hai wo
[C] [D],        Na jaane kyun laga mujhe
[G] [C],        ke muskura rahii hai wo
[G] [C],        Wo shaam kuchh ajeeb thi
[G] [C],        Mera khayaaal hai abhi
[G] [C],        jhuki hui nigaahon mein
[G] [C],        Khuli hui hansii bhi hai
[G] [C],        dabi hui sii chaaah mein
[F] [C],        Main janta hun mera naam
[C] [F],        gungunaa rahii hai wo
[C] [D],        Yahi khayaal hai mujhe
[G] [C],        ke saath aa rahi hai wo
